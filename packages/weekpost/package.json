{
  "name": "weekpost",
  "version": "0.1.0",
  "description": "Your app's weekly social media, as code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchulzWill/weekpost.git",
    "directory": "packages/weekpost"
  },
  "homepage": "https://github.com/SchulzWill/weekpost#readme",
  "bugs": {
    "url": "https://github.com/SchulzWill/weekpost/issues"
  },
  "keywords": [
    "social-media",
    "instagram",
    "content-as-code",
    "ai",
    "agents",
    "claude-code",
    "codex",
    "reels",
    "scheduler"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./worker/index.ts"
  },
  "bin": {
    "weekpost": "./bin/weekpost.js"
  },
  "files": [
    "bin",
    "migrations",
    "src",
    "template",
    "worker"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run -c vitest.db.config.ts",
    "prepack": "node scripts/prepack.mjs",
    "eval:agent": "tsx eval/agent.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.64.1",
    "ffmpeg-static": "^5.3.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.89.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
