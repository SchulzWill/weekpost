prefix_rule(
    pattern = ["wrangler"],
    decision = "forbidden",
    justification = "wrangler deploys and writes infrastructure",
)

prefix_rule(
    pattern = ["npx", "wrangler"],
    decision = "forbidden",
    justification = "wrangler deploys and writes infrastructure",
)

prefix_rule(
    pattern = ["gh", "secret"],
    decision = "forbidden",
    justification = "secrets are set by a human",
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "the merge is the human approval",
)

prefix_rule(
    pattern = ["gh", "pr", "ready"],
    decision = "forbidden",
    justification = "marking ready is the human approval",
)

prefix_rule(
    pattern = ["gh", "api"],
    decision = "forbidden",
    justification = "gh api can add the preview label or change settings",
)

prefix_rule(
    pattern = ["gh", "workflow", "run"],
    decision = "forbidden",
    justification = "workflows run by a human",
)

prefix_rule(
    pattern = ["gh", "label"],
    decision = "forbidden",
    justification = "labels are the human approval",
)

prefix_rule(
    pattern = ["gh", "pr", "edit"],
    decision = "prompt",
    justification = "adding the preview label is the human approval; check the command has no --add-label",
)

prefix_rule(
    pattern = ["gh", "pr", "create"],
    decision = "prompt",
    justification = "creating a pull request with a label is the human approval; check the command has no --label",
)

prefix_rule(
    pattern = ["script"],
    decision = "forbidden",
    justification = "a terminal wrapper would bypass the terminal checks",
)

prefix_rule(
    pattern = ["expect"],
    decision = "forbidden",
    justification = "a terminal wrapper would bypass the terminal checks",
)

prefix_rule(
    pattern = ["unbuffer"],
    decision = "forbidden",
    justification = "a terminal wrapper would bypass the terminal checks",
)
