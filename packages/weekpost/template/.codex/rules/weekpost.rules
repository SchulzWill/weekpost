# Rules for the Codex CLI (https://developers.openai.com/codex/rules). Codex loads this file only when you trust the project.
# "forbidden" blocks a command, "prompt" asks you first, and the strictest matching rule wins.
# These are prefix rules: they match the command words as written, so other ways to run the same program
# (a script, `sh -c '...'`, a variable) can slip through. They reduce accidents; they are not a security boundary.
# `weekpost setup --only=x --apply` is caught by the "prompt" rule for `setup`; `--yes` by the ones for cancel, restore,
# reschedule and resolve. `weekpost metrics --write` and `--issue` are caught by the "prompt" rule for `metrics`.

prefix_rule(
    pattern = ["npx", "weekpost", "setup", "--apply"],
    decision = "forbidden",
    justification = "weekpost setup --apply: writes outside the repository or gives the approval a human must give; run it yourself in a terminal",
)

prefix_rule(
    pattern = ["npx", ["-y", "--yes"], "weekpost", "setup", "--apply"],
    decision = "forbidden",
    justification = "weekpost setup --apply: writes outside the repository or gives the approval a human must give; run it yourself in a terminal",
)

prefix_rule(
    pattern = ["weekpost", "setup", "--apply"],
    decision = "forbidden",
    justification = "weekpost setup --apply: writes outside the repository or gives the approval a human must give; run it yourself in a terminal",
)

prefix_rule(
    pattern = ["./node_modules/.bin/weekpost", "setup", "--apply"],
    decision = "forbidden",
    justification = "weekpost setup --apply: writes outside the repository or gives the approval a human must give; run it yourself in a terminal",
)

prefix_rule(
    pattern = ["node", ["node_modules/weekpost/bin/weekpost.js", "./node_modules/.bin/weekpost"], "setup", "--apply"],
    decision = "forbidden",
    justification = "weekpost setup --apply: writes outside the repository or gives the approval a human must give; run it yourself in a terminal",
)

