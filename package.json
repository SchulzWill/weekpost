{
  "name": "weekpost-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "examples/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:db": "npm run test:db --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "verify": "npm run typecheck && npm test && npm run lint",
    "release": "node packages/weekpost/scripts/release.mjs"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
